{
  "id": "uebungshalle",
  "title": "Übungshalle",
  "subtitle": "Jede Station der Anlage einmal, die Regeln daneben, ohne Uhr",
  "listOrder": 25,
  "order": "free",
  "lit": true,
  "players": { "min": 2, "max": 3 },
  "story": {
    "intro": "Übungshalle der Forschungsanlage Kaltenbrunn: Jede Maschine der Anlage steht hier einmal, ihre Betriebsanleitung daneben. Keine Uhr läuft, keine Drohne fliegt.",
    "win": "Jede Station abgenommen. Die Halle steht für die nächste Schicht bereit.",
    "lose": "Die Übung endet vor der letzten Station. Die Halle bleibt für die nächste Schicht offen."
  },
  "timeLimitSec": 0,
  "hintDelaySec": 20,
  "maxAlarms": null,
  "puzzles": [
    { "type": "button-sync", "id": "button-sync", "title": "Synchrontaster", "hints": [] },
    {
      "type": "wiring",
      "id": "wiring",
      "title": "Brückenkasten",
      "hints": [
        "Einweisung: Erst die Kabel von oben zählen; dann gilt die Liste zu dieser Zahl und ihre erste passende Regel.",
        "Einweisung: Kennung, Leuchten und Zellen stehen auf dem Kennungsschild am Eingang der Halle."
      ]
    },
    {
      "type": "keypad",
      "id": "keypad",
      "title": "Zeichentastenfeld",
      "hints": [
        "Einweisung: Nur eine Spalte der Tafel enthält alle vier Zeichen; dort gilt die Folge von oben nach unten."
      ]
    },
    {
      "type": "switches",
      "id": "switches",
      "title": "Kippschalterbank",
      "hints": [
        "Einweisung: Jeder Schalter hat seine eigene Zeile. Erst alle sechs stellen, dann PRÜFEN.",
        "Einweisung: Für die Zeilen mit „wenn“ zählen Endziffer der Kennung, Zellen und Leuchte SIG."
      ]
    },
    {
      "type": "simon",
      "id": "simon",
      "title": "Abgleichpanel",
      "hints": [
        "Einweisung: Die Kennung wählt die Tabelle, der Alarmstand die Zeile, die blinkende Farbe die Spalte.",
        "Einweisung: Nach einem Alarm gilt die nächste Zeile, und die Stufe beginnt von vorn."
      ]
    },
    {
      "type": "maze",
      "id": "maze",
      "title": "Leitungsnetz",
      "hints": [
        "Einweisung: Nur der Schaltplan zeigt die Wände, das Pult nur den Prüfkopf. Vom Ziel rückwärts ist der Weg kurz."
      ]
    },
    {
      "type": "memory",
      "id": "memory",
      "title": "Speicherbank",
      "hints": [
        "Einweisung: Zu jeder Stufe Platz und Ziffer der angenommenen Taste notieren; die Bank zeigt sie später nicht."
      ]
    },
    {
      "type": "morse",
      "id": "morse",
      "title": "Funkfeuer",
      "hints": [
        "Einweisung: Das Wort beginnt nach der langen Pause. Drei Buchstaben genügen für die Frequenztabelle."
      ]
    },
    {
      "type": "button",
      "id": "button",
      "title": "Druckknopf",
      "hints": [
        "Einweisung: Die Uhr der Halle zählt vorwärts; die gesuchte Ziffer kommt an der letzten Stelle binnen zehn Sekunden."
      ]
    },
    {
      "type": "signal",
      "id": "signal",
      "title": "Signalkette",
      "hints": [
        "Einweisung: Ein Pult zeigt die Folge, das Gegenpult quittiert sie. Es zählen Farbe und Form, nie die Lage der Taste."
      ]
    },
    {
      "type": "circuit",
      "id": "circuit",
      "title": "Sicherungskasten",
      "hints": [
        "Einweisung: Der Kasten zeigt Farben, das Prüfpult Spannungen. Nach jedem Schnitt alle ganzen Kabel neu messen."
      ]
    },
    {
      "type": "servers",
      "id": "servers",
      "title": "Rechnernetz",
      "hints": [
        "Einweisung: Zuerst den Dienst mit E50 vom Strom nehmen, dann von NETZ aus in der Folge des Netzplans hochfahren."
      ]
    }
  ],
