{
  "name": "escapelab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @escapelab/client build",
    "start": "pnpm --filter @escapelab/server start",
    "test": "pnpm -r test && node --test tools/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
