{
  "lines": {
    "anlage-1d6e6f98882a": {
      "text": "Reaktor in Teillast, 60 Prozent. Die Zentrifugen laufen bis 6 Uhr durch.",
      "ms": 6191,
      "missions": [
        "blackout"
      ],
      "role": "pa",
      "person": "anlage",
      "moment": "pa",
      "render": "3c5e5641c282",
      "model": "eleven_v4",
      "file": "anlage-1d6e6f98882a.mp3"
    },
    "anlage-2fec42b4a1b0": {
      "text": "Die Spätschicht gibt Dosimeter und Schlüssel bitte an der Pforte ab.",
      "ms": 4284,
      "missions": [
        "blackout"
      ],
      "role": "pa",
      "person": "anlage",
      "moment": "pa",
      "render": "a015b3c2e2cc",
      "model": "eleven_v4",
      "file": "anlage-2fec42b4a1b0.mp3"
    },
    "anlage-559d72aae03f": {
      "text": "Durchsage der Leitstelle für Trakt C. Es ist 23 Uhr 47, die Nachtschicht hat übernommen.",
      "ms": 7471,
      "missions": [
        "blackout"
      ],
      "role": "pa",
      "person": "anlage",
      "moment": "pa",
      "render": "60a71604dc19",
      "model": "eleven_v4",
      "file": "anlage-559d72aae03f.mp3"
    },
    "anlage-d1ae33eb0de5": {
      "text": "Herr Haller, bitte die Leitstelle anrufen. Herr Haller, bitte die Leitstelle anrufen.",
      "ms": 5721,
      "missions": [
        "blackout"
      ],
      "role": "pa",
      "person": "anlage",
      "moment": "pa",
      "render": "f51b8ffbadd2",
      "model": "eleven_v4",
      "file": "anlage-d1ae33eb0de5.mp3"
    },
    "anlage-db81476a48b2": {
      "text": "Netzlast im Trakt 96 Prozent, Notstrom in Bereitschaft.",
      "ms": 4989,
      "missions": [
        "blackout"
      ],
      "role": "pa",
      "person": "anlage",
      "moment": "pa",
      "render": "e094e9b6f005",
      "model": "eleven_v4",
      "file": "anlage-db81476a48b2.mp3"
    },
    "helmut-02ed4d6ee051": {
      "text": "Server laufen, die Labortür ist offen, drinnen fliegt eine Drohne. Den Aktenschrank im Labor öffnet nur der Schlüssel.",
      "ms": 8202,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "e10aebc8672a",
      "model": "eleven_v4",
      "file": "helmut-02ed4d6ee051.mp3"
    },
    "helmut-06d3d209c3a1": {
      "text": "Wer noch in der Kontrolle steckt: Die Platte im Leitstand vor der Tür hält sie auf.",
      "ms": 5329,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "707ac3b6325b",
      "model": "eleven_v4",
      "file": "helmut-06d3d209c3a1.mp3"
    },
    "helmut-075e89ba063b": {
      "text": "Leitstelle an Nachtschicht. Stromausfall im ganzen Trakt, ich sehe nur noch die Notzellen. Geht zuerst ans Notlicht, der Hauptschalter im Flur braucht zwei Leute.",
      "ms": 10371,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "start",
      "opens": true,
      "render": "3c574d4f4be1",
      "model": "eleven_v4",
      "file": "helmut-075e89ba063b.mp3"
    },
    "helmut-1776e2357724": {
      "text": "Die Synchronkalibrierung steht bei den Spulen, ganz im Osten hinter dem offenen Schott.",
      "ms": 5329,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "572f16eafd23",
      "model": "eleven_v4",
      "file": "helmut-1776e2357724.mp3"
    },
    "helmut-1c32b49724ca": {
      "text": "Notausgang offen, Schleusenmitte. Alle vier hin.",
      "ms": 3709,
      "missions": [
        "doppelschicht"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "escape",
      "render": "6d6c63b60cf9",
      "model": "eleven_v4",
      "file": "helmut-1c32b49724ca.mp3"
    },
    "helmut-20844d2dafb4": {
      "text": "Der Hauptschalter fürs Notlicht hängt mitten im Flur, unter der roten Lampe.",
      "ms": 4833,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "3fb8e31a3f3f",
      "model": "eleven_v4",
      "file": "helmut-20844d2dafb4.mp3"
    },
    "helmut-222d3f3a3601": {
      "text": "Signal steht. Als Nächstes die Kontrolle: Die Platte hält die Tür offen, die Unterlagen liegen im Spind daneben.",
      "ms": 7967,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "7733428013e4",
      "model": "eleven_v4",
      "file": "helmut-222d3f3a3601.mp3"
    },
    "helmut-22f2d6d8fa13": {
      "text": "Alle in den Kern. Flurplatte öffnet das Messlabor.",
      "ms": 4049,
      "missions": [
        "kettenreaktion"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "e79c95867fd2",
      "model": "eleven_v4",
      "file": "helmut-22f2d6d8fa13.mp3"
    },
    "helmut-254093cbcc07": {
      "text": "Schleuse offen. Alle vier zum Not-Aus, Westwand.",
      "ms": 3709,
      "missions": [
        "doppelschicht"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "bfddbf7a0440",
      "model": "eleven_v4",
      "file": "helmut-254093cbcc07.mp3"
    },
    "helmut-337030d21e78": {
      "text": "Leitungsnetz am Westende vom Flur, Kühlmittel zum Kern.",
      "ms": 4362,
      "missions": [
        "kettenreaktion"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "65b5de78b389",
      "model": "eleven_v4",
      "file": "helmut-337030d21e78.mp3"
    },
    "helmut-35c25227f2f1": {
      "text": "Die Unterlagen für Terminal und Rack liegen im Spind, mitten zwischen den beiden.",
      "ms": 5146,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "91d066267e5c",
      "model": "eleven_v4",
      "file": "helmut-35c25227f2f1.mp3"
    },
    "helmut-3818bbb52b0a": {
      "text": "Der Leitstand hat Licht. Jetzt die Signalprobe, zu zweit: Ein Pult zeigt die Zeichen, am anderen drückt ihr sie nach.",
      "ms": 8751,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "34e2879170bc",
      "model": "eleven_v4",
      "file": "helmut-3818bbb52b0a.mp3"
    },
    "helmut-3d87fba381b2": {
      "text": "Notausgang offen, Westende vom Flur. Alle drei hin.",
      "ms": 4206,
      "missions": [
        "kettenreaktion"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "escape",
      "render": "5b79c0ea0e89",
      "model": "eleven_v4",
      "file": "helmut-3d87fba381b2.mp3"
    },
    "helmut-410fa7b4f1db": {
      "text": "Das Funkpult steht im Labor in der Südwestecke, der Aktenschrank im selben Raum.",
      "ms": 5407,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "34beac513104",
      "model": "eleven_v4",
      "file": "helmut-410fa7b4f1db.mp3"
    },
    "helmut-4933b4ca1fd9": {
      "text": "Stellt euch beide an das Pult mit den zwei Griffen, rechts oben im Leitstand.",
      "ms": 4911,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "9356facbacb2",
      "model": "eleven_v4",
      "file": "helmut-4933b4ca1fd9.mp3"
    },
    "helmut-4b13203073f8": {
      "text": "Die Unterlagen liegen im Spind neben der Kontrolltür, lest sie dem vor, der drinnen an den Kabeln steht.",
      "ms": 6609,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "9177cd53b6a7",
      "model": "eleven_v4",
      "file": "helmut-4b13203073f8.mp3"
    },
    "helmut-4f5494825480": {
      "text": "Pult A der Signalkette steht am Ostende vom Flur, Pult B im Maschinenraum in der Südostecke.",
      "ms": 6766,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "8d240e775f7a",
      "model": "eleven_v4",
      "file": "helmut-4f5494825480.mp3"
    },
    "helmut-5d1ab414fef4": {
      "text": "Reaktor läuft. Der Notausgang ist entriegelt, Nordwestecke beim Archiv. Alle raus, jetzt.",
      "ms": 6687,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "escape",
      "render": "4ff489bb4806",
      "model": "eleven_v4",
      "file": "helmut-5d1ab414fef4.mp3"
    },
    "helmut-63b85185d3f6": {
      "text": "Tastenfeld im Westflügel, Südostecke. Regeln im Nordosten.",
      "ms": 5251,
      "missions": [
        "doppelschicht"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "daf0a65dd959",
      "model": "eleven_v4",
      "file": "helmut-63b85185d3f6.mp3"
    },
    "helmut-6552b388f95a": {
      "text": "Schalter und Sicherungsplatz sitzen im Reaktor ganz hinten an der Ostwand, dort kommt die Sicherung rein.",
      "ms": 6531,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "04dacd590bae",
      "model": "eleven_v4",
      "file": "helmut-6552b388f95a.mp3"
    },
    "helmut-6b1eb79786bd": {
      "text": "Notstrom zuerst: Kasten im Ostflügel, Regeln im Südwesten.",
      "ms": 5251,
      "missions": [
        "doppelschicht"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "start",
      "opens": true,
      "render": "514c2d7484ae",
      "model": "eleven_v4",
      "file": "helmut-6b1eb79786bd.mp3"
    },
    "helmut-78885b2579ba": {
      "text": "Frequenz steht, ich höre euch klar. Der Reaktor ist offen, ohne Ersatzsicherung bleibt er aber tot.",
      "ms": 6922,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "a6840fe58afb",
      "model": "eleven_v4",
      "file": "helmut-78885b2579ba.mp3"
    },
    "helmut-7c8343fceedc": {
      "text": "Leitstand offen. Freigabecode dort, Regeln im Messlabor.",
      "ms": 4989,
      "missions": [
        "kettenreaktion"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "c30f8ec25252",
      "model": "eleven_v4",
      "file": "helmut-7c8343fceedc.mp3"
    },
    "helmut-7cf7ab52533d": {
      "text": "Das Prüfpult steht am Westende vom Flur, der Kasten im Maschinenraum hinter der Plattentür, einer bleibt auf der Platte.",
      "ms": 7967,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "e1227ae567a6",
      "model": "eleven_v4",
      "file": "helmut-7cf7ab52533d.mp3"
    },
    "helmut-817d23810d00": {
      "text": "Resonator offen. Station dahinter, durch die Westtür.",
      "ms": 4206,
      "missions": [
        "kettenreaktion"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "77e86c37f24f",
      "model": "eleven_v4",
      "file": "helmut-817d23810d00.mp3"
    },
    "helmut-8849fe962d54": {
      "text": "Das Terminal steht an der Westwand vom Serverraum, das Rack gegenüber an der Ostwand, je einer an jedes.",
      "ms": 7393,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "89c8f1915b27",
      "model": "eleven_v4",
      "file": "helmut-8849fe962d54.mp3"
    },
    "helmut-8b10933ddf2f": {
      "text": "Schott zum Serverraum ist offen, drinnen Terminal und Rack. Die Drohne ist wach, die Kameraplatte davor legt sie still.",
      "ms": 8516,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "d9a2f850d2cf",
      "model": "eleven_v4",
      "file": "helmut-8b10933ddf2f.mp3"
    },
    "helmut-8f10dc1c71d9": {
      "text": "Leitstelle an Schulungsgruppe. Nur eine Übung, bei euch ist noch alles aus. Geht beide zur Initialisierung und legt die Hebel gleichzeitig um.",
      "ms": 9247,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "start",
      "opens": true,
      "render": "fbe5226baaec",
      "model": "eleven_v4",
      "file": "helmut-8f10dc1c71d9.mp3"
    },
    "helmut-91aa63cd0d29": {
      "text": "Notlicht steht, danke. Jetzt der Notstrom: Die Anleitung dafür hängt im Archiv, der Kasten ist im Maschinenraum, das Prüfpult im Flur.",
      "ms": 10762,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "0d41e085163d",
      "model": "eleven_v4",
      "file": "helmut-91aa63cd0d29.mp3"
    },
    "helmut-922917db41dc": {
      "text": "Das Klemmbrett zur Signalkette liegt im Flur, an der Südwand.",
      "ms": 4127,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "c96d87202bc2",
      "model": "eleven_v4",
      "file": "helmut-922917db41dc.mp3"
    },
    "helmut-997eda98f143": {
      "text": "Systeme laufen. Der Notausgang ist entriegelt, oben im Leitstand an der Nordwand. Beide raus, jetzt.",
      "ms": 7236,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "escape",
      "render": "154b065e0900",
      "model": "eleven_v4",
      "file": "helmut-997eda98f143.mp3"
    },
    "helmut-9dc804d5a806": {
      "text": "Der Hebel für die Initialisierung hängt im Leitstand an der Nordwand, rechts.",
      "ms": 5251,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "f6250580d5a8",
      "model": "eleven_v4",
      "file": "helmut-9dc804d5a806.mp3"
    },
    "helmut-9f5039973bf5": {
      "text": "Kühlbank im Westflügel, Westwand. Regeln im Südosten.",
      "ms": 4833,
      "missions": [
        "doppelschicht"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "7b6effe0bd16",
      "model": "eleven_v4",
      "file": "helmut-9f5039973bf5.mp3"
    },
    "helmut-9f756efbf1b6": {
      "text": "Der Schlüssel zum Aktenschrank liegt im Serverraum, in der Nordostecke über dem Rack.",
      "ms": 5251,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "ab715bf2b32a",
      "model": "eleven_v4",
      "file": "helmut-9f756efbf1b6.mp3"
    },
    "helmut-a05a06d81e0a": {
      "text": "Die Unterlagen zur Signalprobe liegen im Spind, oben links im Leitstand.",
      "ms": 4754,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "10cc2ed26c95",
      "model": "eleven_v4",
      "file": "helmut-a05a06d81e0a.mp3"
    },
    "helmut-a242523a34e9": {
      "text": "Speicherkern an die Schleusenwand, Schaltplan im Nordwesten.",
      "ms": 4127,
      "missions": [
        "doppelschicht"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "0bb498c9efab",
      "model": "eleven_v4",
      "file": "helmut-a242523a34e9.mp3"
    },
    "helmut-a4926baec4a2": {
      "text": "Wer noch im Archiv ist: durch die Südtür in den Flur, dann ein Stück nach Osten zum Hauptschalter.",
      "ms": 6922,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "d0e09221779b",
      "model": "eleven_v4",
      "file": "helmut-a4926baec4a2.mp3"
    },
    "helmut-a7a4fd0abde0": {
      "text": "Funkpult im Ostflügel, Ostwand. Regeln im Südwesten.",
      "ms": 4754,
      "missions": [
        "doppelschicht"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "27ec7493dda9",
      "model": "eleven_v4",
      "file": "helmut-a7a4fd0abde0.mp3"
    },
    "helmut-b026b38b6ad9": {
      "text": "Die Anleitung zum Notstrom hängt im Archiv, auf der Ostseite.",
      "ms": 4284,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "248129959c0c",
      "model": "eleven_v4",
      "file": "helmut-b026b38b6ad9.mp3"
    },
    "helmut-cbfc00e89853": {
      "text": "Die Ersatzsicherung für den Reaktor liegt im Archiv, in der Südostecke.",
      "ms": 4754,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "551b5986d3b3",
      "model": "eleven_v4",
      "file": "helmut-cbfc00e89853.mp3"
    },
    "helmut-ceb43276953b": {
      "text": "Notstrom läuft, die Tür zum Maschinenraum bleibt offen. Als Nächstes die Signalkette: ein Pult im Flur, eins im Maschinenraum.",
      "ms": 9326,
      "missions": [
        "blackout"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "394bf291df3e",
      "model": "eleven_v4",
      "file": "helmut-ceb43276953b.mp3"
    },
    "helmut-d6b1ce9ed9c7": {
      "text": "Die Pulte der Signalprobe stehen im Leitstand an der Südwand, eins links, eins rechts.",
      "ms": 6034,
      "missions": [
        "systemcheck"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "nudge",
      "render": "e021c6249311",
      "model": "eleven_v4",
      "file": "helmut-d6b1ce9ed9c7.mp3"
    },
    "helmut-e036051a6037": {
      "text": "Druckknopf im Westflügel, Nordseite. Regeln im Nordosten.",
      "ms": 4911,
      "missions": [
        "doppelschicht"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
      "render": "ebc449b6ad97",
      "model": "eleven_v4",
      "file": "helmut-e036051a6037.mp3"
    },
    "helmut-e291391e6b9b": {
      "text": "Platten in Archiv und Messlabor öffnen die Schleuse. Erste Station im Flur.",
      "ms": 5799,
      "missions": [
        "kettenreaktion"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "start",
      "opens": true,
      "render": "ab319fef8372",
      "model": "eleven_v4",
      "file": "helmut-e291391e6b9b.mp3"
    },
    "helmut-e753b688f370": {
      "text": "Weiter im Pumpenraum, Südost. Regeln wieder im Archiv.",
      "ms": 4754,
      "missions": [
        "kettenreaktion"
      ],
      "role": "operator",
      "person": "helmut",
      "moment": "solved",
